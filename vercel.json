{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "compiler": "typescript"
      }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/src/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
